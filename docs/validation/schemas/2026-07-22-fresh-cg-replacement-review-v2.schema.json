{
  "$defs": {
    "ExactSourceSpan": {
      "additionalProperties": false,
      "description": "One exact half-open span in the frozen UTF-8 source text.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "ExactSourceSpan",
      "type": "object"
    },
    "FreshCGCaseSemanticReview": {
      "additionalProperties": false,
      "description": "One reviewer's independent source-semantic judgment for a selected case.",
      "properties": {
        "arguments": {
          "items": {
            "$ref": "#/$defs/ReviewedArgument"
          },
          "minItems": 1,
          "title": "Arguments",
          "type": "array"
        },
        "case_id": {
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "comparison": {
          "$ref": "#/$defs/ReviewedComparison"
        },
        "direction": {
          "$ref": "#/$defs/ReviewedDirection"
        },
        "event_anchor_id": {
          "minLength": 1,
          "title": "Event Anchor Id",
          "type": "string"
        },
        "overall_rationale": {
          "minLength": 1,
          "title": "Overall Rationale",
          "type": "string"
        },
        "permitted_contextual_participants": {
          "items": {
            "$ref": "#/$defs/ReviewedContextParticipant"
          },
          "title": "Permitted Contextual Participants",
          "type": "array"
        },
        "polarity": {
          "$ref": "#/$defs/ReviewedPolarity"
        },
        "statistics": {
          "$ref": "#/$defs/ReviewedStatistics"
        },
        "uncertainty": {
          "$ref": "#/$defs/ReviewedUncertainty"
        }
      },
      "required": [
        "case_id",
        "event_anchor_id",
        "arguments",
        "direction",
        "comparison",
        "polarity",
        "uncertainty",
        "statistics",
        "permitted_contextual_participants",
        "overall_rationale"
      ],
      "title": "FreshCGCaseSemanticReview",
      "type": "object"
    },
    "RetrievedPrimarySource": {
      "additionalProperties": false,
      "description": "Reviewer-recorded custody for the public primary retrieval.",
      "properties": {
        "context_verified": {
          "title": "Context Verified",
          "type": "boolean"
        },
        "document_id": {
          "pattern": "^PMID-\\d+$",
          "title": "Document Id",
          "type": "string"
        },
        "response_bytes_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Response Bytes Sha256",
          "type": "string"
        },
        "retrieval_url": {
          "minLength": 1,
          "title": "Retrieval Url",
          "type": "string"
        },
        "retrieved_at_utc": {
          "minLength": 1,
          "title": "Retrieved At Utc",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "retrieval_url",
        "retrieved_at_utc",
        "response_bytes_sha256",
        "context_verified"
      ],
      "title": "RetrievedPrimarySource",
      "type": "object"
    },
    "ReviewedArgument": {
      "additionalProperties": false,
      "description": "Artana role for one anchored direct-CG participant occurrence.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/ExactSourceSpan"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "role": {
          "enum": [
            "AFFECTED_ENTITY",
            "CAUSAL_AGENT",
            "STIMULUS_OR_OBJECT",
            "POPULATION",
            "COMPARATOR",
            "OUTCOME",
            "EXPOSURE",
            "MEASUREMENT",
            "CONTEXTUAL_PARTICIPANT",
            "EFFECT_EVENT"
          ],
          "title": "Role",
          "type": "string"
        },
        "target_anchor_id": {
          "minLength": 1,
          "title": "Target Anchor Id",
          "type": "string"
        }
      },
      "required": [
        "target_anchor_id",
        "role",
        "evidence",
        "rationale"
      ],
      "title": "ReviewedArgument",
      "type": "object"
    },
    "ReviewedComparison": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/ExactSourceSpan"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "enum": [
            "GREATER",
            "LESS",
            "NO_DIFFERENCE",
            "NOT_APPLICABLE"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "evidence",
        "rationale"
      ],
      "title": "ReviewedComparison",
      "type": "object"
    },
    "ReviewedContextParticipant": {
      "additionalProperties": false,
      "description": "Additional explicit participant permitted by the selected source context.",
      "properties": {
        "context_id": {
          "minLength": 1,
          "title": "Context Id",
          "type": "string"
        },
        "entity_type": {
          "enum": [
            "POPULATION",
            "OUTCOME",
            "EXPOSURE",
            "VARIANT",
            "GENE_OR_PROTEIN",
            "CANCER",
            "SIMPLE_CHEMICAL",
            "MEASUREMENT"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "mention": {
          "$ref": "#/$defs/ExactSourceSpan"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "role": {
          "enum": [
            "AFFECTED_ENTITY",
            "CAUSAL_AGENT",
            "STIMULUS_OR_OBJECT",
            "POPULATION",
            "COMPARATOR",
            "OUTCOME",
            "EXPOSURE",
            "MEASUREMENT",
            "CONTEXTUAL_PARTICIPANT"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "entity_type",
        "mention",
        "role",
        "rationale"
      ],
      "title": "ReviewedContextParticipant",
      "type": "object"
    },
    "ReviewedDirection": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/ExactSourceSpan"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "enum": [
            "INCREASED",
            "DECREASED",
            "NO_DIFFERENCE",
            "NO_ASSOCIATION",
            "ENABLES",
            "OBSERVED",
            "NOT_APPLICABLE"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "evidence",
        "rationale"
      ],
      "title": "ReviewedDirection",
      "type": "object"
    },
    "ReviewedPolarity": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/ExactSourceSpan"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "enum": [
            "AFFIRMED",
            "NEGATED",
            "NULL_RESULT"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "evidence",
        "rationale"
      ],
      "title": "ReviewedPolarity",
      "type": "object"
    },
    "ReviewedStatisticalObservation": {
      "additionalProperties": false,
      "description": "One explicit statistical observation, if present.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/ExactSourceSpan"
        },
        "observation_type": {
          "enum": [
            "P_VALUE",
            "CONFIDENCE_INTERVAL",
            "EFFECT_ESTIMATE"
          ],
          "title": "Observation Type",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "observation_type",
        "evidence",
        "rationale"
      ],
      "title": "ReviewedStatisticalObservation",
      "type": "object"
    },
    "ReviewedStatistics": {
      "additionalProperties": false,
      "description": "Separate observed statistics from an author's significance interpretation.",
      "properties": {
        "author_interpretation": {
          "enum": [
            "SIGNIFICANT",
            "NOT_SIGNIFICANT",
            "NOT_CLAIMED"
          ],
          "title": "Author Interpretation",
          "type": "string"
        },
        "interpretation_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactSourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/ReviewedStatisticalObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "observations",
        "author_interpretation",
        "interpretation_evidence",
        "rationale"
      ],
      "title": "ReviewedStatistics",
      "type": "object"
    },
    "ReviewedUncertainty": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "$ref": "#/$defs/ExactSourceSpan"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "value": {
          "enum": [
            "ASSERTED",
            "PROVISIONAL",
            "UNCERTAIN",
            "HYPOTHESIS"
          ],
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "evidence",
        "rationale"
      ],
      "title": "ReviewedUncertainty",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One reviewer's source-only judgment of the added reserve case.",
  "properties": {
    "case": {
      "$ref": "#/$defs/FreshCGCaseSemanticReview"
    },
    "implementation_reference_blinded": {
      "const": true,
      "default": true,
      "title": "Implementation Reference Blinded",
      "type": "boolean"
    },
    "independence_declaration": {
      "minLength": 1,
      "title": "Independence Declaration",
      "type": "string"
    },
    "internet_enabled": {
      "const": true,
      "default": true,
      "title": "Internet Enabled",
      "type": "boolean"
    },
    "model_output_blinded": {
      "const": true,
      "default": true,
      "title": "Model Output Blinded",
      "type": "boolean"
    },
    "other_reviewer_output_blinded": {
      "const": true,
      "default": true,
      "title": "Other Reviewer Output Blinded",
      "type": "boolean"
    },
    "retrieved_source": {
      "$ref": "#/$defs/RetrievedPrimarySource"
    },
    "review_packet_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Packet Sha256",
      "type": "string"
    },
    "review_prompt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Prompt Sha256",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "reviewer_model_identity": {
      "minLength": 1,
      "title": "Reviewer Model Identity",
      "type": "string"
    },
    "reviewer_task_identity": {
      "minLength": 1,
      "title": "Reviewer Task Identity",
      "type": "string"
    },
    "schema_version": {
      "const": "artana.staged_generalization.fresh_cg_replacement_reviewer.v2",
      "default": "artana.staged_generalization.fresh_cg_replacement_reviewer.v2",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "reviewer_id",
    "reviewer_task_identity",
    "reviewer_model_identity",
    "review_prompt_sha256",
    "review_packet_sha256",
    "retrieved_source",
    "case",
    "independence_declaration"
  ],
  "title": "ReplacementReviewFragmentV2",
  "type": "object"
}
